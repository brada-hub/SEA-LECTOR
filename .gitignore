# ==========================================
# SEA LECTOR - Git Ignore Configuration
# ==========================================

# Dependencias Node.js (Frontend & Backend)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Builds y Compilados Temporales
backend/dist/
frontend/.next/
frontend/out/
frontend/build/
dist/
build/
*.tsbuildinfo

# Logs y depuración
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bridge_debug.log

# Variables de entorno y secretos
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Vercel / Despliegues
.vercel/

# Archivos del Sistema Operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores / IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/
*.suo
*.user
*.useroscan
*.sln.docstates
